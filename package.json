{
  "name": "manka",
  "version": "1.0.1",
  "private": true,
  "productName": "Manka",
  "desktopName": "manka.desktop",
  "description": "Manka - Konveksi Business Manager (offline-first Android, browser, dan Linux)",
  "homepage": "https://github.com/isacapocalype/Manka",
  "author": "Manka",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android:build": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "linux:run": "npm run build && electron .",
    "linux:build": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "linux:pack": "electron-builder --linux AppImage --x64 --publish never",
    "linux:deb": "npm run build && electron-builder --linux deb --x64 --publish never",
    "linux:pack:deb": "electron-builder --linux deb --x64 --publish never",
    "linux:packages": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/inter": "^5.3.0",
    "chart.js": "^4.6.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide": "^1.73.0",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^24.0.0",
    "@types/sql.js": "^1.4.11",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "id.manka.konveksi",
    "productName": "Manka",
    "copyright": "Manka",
    "asar": true,
    "npmRebuild": false,
    "toolsets": {
      "appimage": "1.0.3"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "manka",
      "category": "Office",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "Manka-${version}-${arch}.${ext}",
      "synopsis": "Manajemen bisnis konveksi offline-first",
      "description": "Manka menyimpan data toko, pesanan, produk, dan keuangan secara lokal tanpa server.",
      "maintainer": "Manka"
    },
    "deb": {
      "recommends": [],
      "artifactName": "manka_${version}_${arch}.${ext}"
    }
  }
}
